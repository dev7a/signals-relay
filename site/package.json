{
  "name": "signals-relay-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:content": "node ./scripts/generate-content.mjs",
    "build": "pnpm run generate:content && fumadocs-mdx && next build",
    "dev": "pnpm run generate:content && fumadocs-mdx && next dev",
    "start": "node ./scripts/serve-export.mjs",
    "types:check": "node ./scripts/types-check.mjs"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "16.8.5",
    "lucide-react": "1.11.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@types/mdx": "2.0.13",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.12",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3"
  }
}
